# Copy to .env.prod on the VM (never commit it). One value per line, no quotes.

# --- hostnames: VM public IP with dashes + .sslip.io
DOMAIN_SUFFIX=140-238-1-2.sslip.io

# --- Postgres runs on the VM (user jobradar); pick a long random password
DB_PASSWORD=

# --- shared JWT secret (32+ chars), same for all services
JWT_SECRET=

# --- browsers allowed to call the APIs (Vercel URLs)
CORS_ORIGINS=https://jobradar-shell.vercel.app,https://jobs-feed-mfe.vercel.app,https://insights-mfe.vercel.app
FRONTEND_URL=https://jobradar-shell.vercel.app

# --- email out (Gmail SMTP with the app password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=

# --- email in (LinkedIn / Naukri alerts over IMAP, same app password)
IMAP_USERNAME=
IMAP_PASSWORD=

# --- job APIs and AI
JSEARCH_API_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
